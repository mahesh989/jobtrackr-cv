# Every operator-controlled environment variable read by the worker is listed
# here. Fly/APIFY runtime metadata (FLY_*, APIFY_INPUT_PATH,
# APIFY_ACTOR_RUN_ID) is injected by those platforms and is not configured by
# an operator.

# Upstash Redis (free tier)
# From: https://console.upstash.com → Databases → your db → "Redis Connect" → ioredis
REDIS_URL=redis://default:<password>@<your-db>.upstash.io:6379


# Supabase
SUPABASE_URL=https://<your-project-ref>.supabase.co
# Service-role key bypasses RLS — NEVER commit a real one. Copy from
# Supabase → Project Settings → API. Keep it only in the deployment secret store.
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# CV backend — both values must match frontend/web and backend/api.
CV_BACKEND_URL=http://localhost:8000
JOBTRACKR_HMAC_SECRET=<shared-hmac-secret>

# AES-256-GCM key for decrypting stored integration credentials.
# Generate 64 hex characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_ENCRYPTION_KEY=<64-hex-characters>

# Shared global job bucket. Production uses true; false retains the legacy
# per-profile filtering path.
USE_GLOBAL_BUCKET=true

# Public web origin used in links sent by worker notifications.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI provider — "openai" (dev) or "anthropic" (production)
AI_PROVIDER=openai

# OpenAI — used when AI_PROVIDER=openai (gpt-4o-mini)
OPENAI_API_KEY=

# Anthropic — used when AI_PROVIDER=anthropic (claude-haiku-4-5 Batch API)
ANTHROPIC_API_KEY=

# Adzuna (Phase 2+)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Apify actor IDs — fallback paths only (SEEK/Careerjet/Adzuna primarily
# scrape directly). SEEK_ACTOR_ID has a code-level default; the other two
# default to empty and must be set for their Apify fallback path to work.
SEEK_ACTOR_ID=
ADZUNA_ACTOR_ID=
CAREERJET_ACTOR_ID=

# Optional Apify residential proxy used by direct SEEK/Careerjet scraping.
APIFY_PROXY_PASSWORD=

# Optional direct Careerjet API fallback. Unset disables that fallback.
CAREERJET_API_KEY=

# Optional AI setting classifier; deterministic classification remains active.
SETTING_CLASSIFIER_AI=false

# Resend (Phase 6+)
# USER ACTION: Create account at resend.com, verify sender domain, then fill in:
RESEND_API_KEY=
RESEND_FROM_EMAIL=JobTrackr <noreply@yourdomain.com>

# Optional recipient for worker pipeline-error alerts.
FOUNDER_ALERT_EMAIL=
