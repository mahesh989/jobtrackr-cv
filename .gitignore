# Test artefacts and one-off scripts — removed 2026-05-16
# Do not re-add these. If you need ad-hoc scraping scripts, put them in
# /scripts/ at repo root with a clear name and commit them properly.
frontend/web/jora_jobs_*.csv
frontend/web/discovered_slugs.json
frontend/web/jora_scraper.py
frontend/web/verify_slugs.py
backend/worker/jora_test_*.json
backend/worker/test-update.js
backend/worker/fix-dead-links.js

# Generated output from the perf-measurement scripts — regenerate with
# `node scripts/discover-routes.mjs` / `measure-everything.mjs`, don't commit.
frontend/web/scripts/.measure-everything-results.json
frontend/web/scripts/.routes-manifest.json

# Scraper probe/debug scripts — one-off diagnostics, not production code
backend/worker/scripts/seek-*.ts
backend/worker/scripts/.seek-capture/
backend/worker/src/scripts/test*.ts
shared/supabase/migrations/ain_jobs*.json
shared/supabase/migrations/scrape_*.py
.env*.local

# Local Scraper Tests
shared/supabase/migrations/careerjet_data_analyst_melbourne.json
shared/supabase/migrations/careerjet_sample.html

# Apify SDK local runtime state — auto-generated on actor run, never read in prod
backend/worker/src/sources/*/storage/
backend/worker/apify-actors/*/storage/

# Postman desktop/VS Code extension local workspace sync — not app code.
.postman/resources.yaml
postman/
references/*

# Postman OpenAPI spec import — kept locally only, not read by CI/deploy/app.
.postman/collections/

# Design mockups / HTML prototypes — contain secrets, never committed
form-patterns.html
nav-mockup.html
job-board-toolbar-v2.html

# opencode CLI tooling — local dev tool config only, not read by CI/deploy
# or the app itself. Keep locally; do not sync to remote.
/opencode.json
/package.json
/package-lock.json
.opencode/skills/

# Claude Code personal tool config — agent/command/hook/preview defs are
# a personal workflow choice, not read by CI/deploy/app. graph.json stays
# tracked (session-continuity state per CLAUDE.md). Keep these locally.
.claude/agents/
.claude/commands/
.claude/prompts/
.claude/settings.json
.claude/launch.json
# Mirrors of the .claude/agents/ + .claude/commands/ config above, generated
# locally for other CLI tools (Codex, generic .agents/ skill format) —
# same personal-workflow rationale, same gitignore treatment.
.agents/
.codex/
backend/worker/src/sources/careerjet_actor/node_modules/
backend/worker/src/sources/*/node_modules/
