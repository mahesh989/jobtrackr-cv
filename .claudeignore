# ============================================================
# .claudeignore — keeps Claude's context window focused on
# the code that actually matters for JobTrackr-CV work.
# Rule of thumb: if Claude would never need to READ it to do
# CV-integration work, block it here.
# ============================================================

# ── Dependencies & lockfiles ────────────────────────────────
# 526 MB of node_modules + thousands of lockfile lines = pure waste
**/node_modules/
**/package-lock.json
**/yarn.lock
**/pnpm-lock.yaml

# ── Build & cache artefacts ─────────────────────────────────
**/.next/
**/dist/
**/build/
**/out/
**/.vercel/
**/__pycache__/
**/*.pyc
**/*.tsbuildinfo

# ── Worker service (job-discovery pipeline) ─────────────────
# NOT blocked wholesale any more: the worker is actively developed here
# (sources, orchestrator, JD facts), so its TypeScript source must stay
# readable. Only the bulky non-source parts are blocked below.
backend/worker/**/storage/
backend/worker/apify-actors/*/storage/
backend/worker/**/package-lock.json

# ── Static / media assets ───────────────────────────────────
frontend/web/public/
*.svg
*.png
*.jpg
*.jpeg
*.gif
*.ico
*.webp
*.woff
*.woff2
*.ttf
*.otf

# ── Test data dumps & large JSON state files ────────────────
**/storage/
jobs.json
jora_test_*.json
**/*.test-output.json

# ── Environment & secrets ───────────────────────────────────
.env*

# ── Editor / OS noise ───────────────────────────────────────
.DS_Store
.vscode/
.idea/
**/*.swp
**/*.swo

# ── Logs ────────────────────────────────────────────────────
*.log
*.csv

# ── Supabase internals ──────────────────────────────────────
shared/supabase/.temp/
shared/supabase/.branches/
